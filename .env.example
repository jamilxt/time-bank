# Copy to keys.env and fill in. The server reads these at startup.
# Without keys, Time Bank runs in demo mode: keyword matching + browser speech.
GEMINI_API_KEY=your_google_ai_studio_key
ELEVENLABS_API_KEY=your_elevenlabs_key
# Optional
# GEMINI_MODEL=gemini-2.5-flash
# TIMEBANK_PORT=8791
# TIMEBANK_DATA=/var/www/timebank/data.json
